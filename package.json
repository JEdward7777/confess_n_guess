  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.4",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260718.1",
    "@types/express": "^4.17.21",
    "wrangler": "^4.112.0"
  }
}
