{
  "name": "confess_n_guess",
  "version": "1.0.0",
  "description": "A Fibbage-style party game on Cloudflare Workers + Durable Objects.",
  "main": "index.js",
  "scripts": {
    "prestart": "node scripts/ensure-build.js",
    "start": "wrangler dev",
    "deploy": "npm run build_client && wrangler deploy",
    "build_shared": "tsc",
    "build_client": "(cd confess_n_guess_client && npm run build)",
    "build": "npm run build_client && npm run build_shared",
    "check_worker": "tsc -p tsconfig.worker.json",
    "test": "npm run build && npm run check_worker && node tests/run.js",
    "test:only": "node tests/run.js"
  },
  "author": "Joshua Lansford",
  "license": "MIT",
  "dependencies": {
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260718.1",
    "puppeteer-core": "^25.3.0",
    "wrangler": "^4.112.0"
  }
}
